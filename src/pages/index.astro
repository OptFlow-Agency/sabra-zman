<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#6e1e3a" />
    <title>Maison Sabra</title>
    <link rel="icon" href="/assets/logo-ms.webp" type="image/webp" />
    <style>
      html, body { height: 100%; margin: 0; }
      body { display: grid; place-items: center; background: #faf6ef; }
      .loader {
        width: 44px; height: 44px; border-radius: 50%;
        border: 3px solid #e6dccb; border-top-color: #6e1e3a;
        animation: spin 0.9s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .loader { animation-duration: 3s; } }
    </style>
  </head>
  <body>
    <div class="loader" role="status" aria-label="Chargement"></div>
    <noscript><meta http-equiv="refresh" content="0;url=/zmancollection/lp" /></noscript>
    <script is:inline>
      setTimeout(function () {
        location.replace("/zmancollection/lp" + location.search + location.hash);
      }, 1200);
    </script>
  </body>
</html>
